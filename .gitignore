airflow/*.pid
airflow/standalone_admin_password.txt

# Streamlit secrets
.streamlit/secrets.toml

# ML experiment tracking (not the final models)
mlruns/
mlflow.db
*.log

# Python packaging
*.egg-info/
build/
dist/

# OS files
.DS_Store
Thumbs.db